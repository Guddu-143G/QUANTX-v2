# Generate a long, unique value for production; never commit your real secret.
SESSION_SECRET=replace-with-a-long-random-production-secret
APP_ENV=production
SESSION_TTL_HOURS=8
# Optional: place the SQLite database outside the application directory in production.
# QUANTX_DATABASE_URL=/secure/path/quantx.db

# Kite Connect Authentication
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Redis (for WebSocket PubSub)
REDIS_URL=redis://localhost:6379/0
