# ==============================================================================
# QUANTX — Zerodha Kite Connect v3 Credentials & Exchange Settings
# ==============================================================================
# 1. Enter your Kite API Key and Secret from https://developers.kite.trade/apps
KITE_API_KEY=
KITE_API_SECRET=

# 2. Enter your daily Access Token (generated after completing the OAuth login)
# Note: Zerodha Kite access tokens are valid for 24 hours (until 06:00 AM IST).
KITE_ACCESS_TOKEN=

# 3. Optional: Your Zerodha Client ID
KITE_USER_ID=

# ==============================================================================
# Platform Server Configuration
# ==============================================================================
APP_ENV=development
PORT=8001
HOST=0.0.0.0
SESSION_SECRET=quantx-sovereign-grade-256-bit-key-here
SESSION_TTL_HOURS=8
QUANTX_DATABASE_URL=quantx.db
