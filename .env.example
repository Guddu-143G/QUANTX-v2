# ==============================================================================
# QUANTX Platform — Environment Variables Template
# ==============================================================================

# 1. Zerodha Kite Connect v3 Credentials (Optional - for live DMA broker syncing)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_USER_ID=

# 2. Vercel & Cloud Deployment Configuration
# Set VITE_BACKEND_URL in your Vercel Dashboard under Settings -> Environment Variables.
# Do NOT commit production backend URLs directly to GitHub.
# VITE_BACKEND_URL=https://your-backend-deployment.up.railway.app

# 3. Platform Server Configuration
APP_ENV=development
PORT=8001
HOST=0.0.0.0
SESSION_SECRET=quantx-sovereign-grade-256-bit-key-here
SESSION_TTL_HOURS=8
QUANTX_DATABASE_URL=quantx.db
